# Neon PostgreSQL — use a URL "pooled" aqui
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — use a URL "direct" aqui (para migrations/db push)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"


# Autenticação — defina um segredo aleatório com pelo menos 24 caracteres
AUTH_SECRET=

# Senhas iniciais das contas compartilhadas; usadas somente se a tabela User estiver vazia
SEED_GERENCIAL_PASSWORD=
SEED_COMERCIAL_PASSWORD=
