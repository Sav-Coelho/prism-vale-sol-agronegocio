// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Unit {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  active  Boolean  @default(true)
  clients Client[]
  sales   Sale[]
}

model Client {
  id        Int      @id @default(autoincrement())
  code      String?  @unique  // Código do ERP — chave estável de deduplicação
  name      String
  email     String?
  phone     String?
  cpf       String?
  unitId    Int?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Sale {
  id            Int       @id @default(autoincrement())
  clientId      Int
  client        Client    @relation(fields: [clientId], references: [id])
  externalId    String?   // Chave estável do ERP: TITULO::PARCELA (deduplica entre imports)
  description   String
  amount        Float
  date          DateTime
  dueDate       DateTime?
  paidDate      DateTime?
  paymentStatus String    @default("PENDING") // PENDING / PAID / OVERDUE / DEFAULTED
  unitId        Int?
  unit          Unit?     @relation(fields: [unitId], references: [id])
  month         Int
  year          Int
  createdAt     DateTime  @default(now())

  @@unique([clientId, externalId])
  @@index([externalId])
  @@index([paymentStatus])
}

// Títulos a receber importados do ERP do cliente
model Receivable {
  id              Int       @id @default(autoincrement())
  fitid           String    @unique
  dueDate         DateTime
  issueDate       DateTime?
  customerCode    String?
  customerName    String
  customerDoc     String?
  titulo          String
  parcela         String?
  portador        String?
  tipoCobranca    String?
  sellerCode      String?
  sellerName      String?
  farmName        String?
  phone           String?
  amount          Float
  discount        Float     @default(0)
  interest        Float     @default(0)
  fine            Float     @default(0)
  netAmount       Float
  filial          String?
  observation     String?
  status          String    @default("PENDING")    // PENDING / RECEIVED
  receivedDate    DateTime?
  importedAt      DateTime  @default(now())

  @@index([dueDate])
  @@index([customerDoc])
  @@index([status])
}

// Preço de venda (tabela mestre, sem filial) — do XLSX PREÇO DE VENDA
model ProductPrice {
  code        String   @id
  description String
  retailPrice Float
  updatedAt   DateTime @default(now()) @updatedAt
}

// Estoque consolidado (sem filial por ora) — do XLSX ABC DE ESTOQUE (sheet CONSOLIDADO)
model StockItem {
  code        String   @id
  description String
  qty         Float
  unitCost    Float
  totalValue  Float
  updatedAt   DateTime @default(now()) @updatedAt
}

// Curva ABC de vendas consolidada — do XLSX RELATORIO ABC DE VENDAS (sheet CONSOLIDADO)
model SalesAbcItem {
  code        String   @id
  description String
  qtySold     Float
  totalValue  Float
  avgUnit     Float
  abcClass    String   // A / B / C
  updatedAt   DateTime @default(now()) @updatedAt
}

// Pagamentos a efetuar importados do ERP do cliente
model Payable {
  id              Int       @id @default(autoincrement())
  fitid           String    @unique
  dueDate         DateTime
  entryDate       DateTime?
  supplierCode    String?
  supplierName    String
  supplierDoc     String?
  titulo          String
  parcela         String?
  amount          Float
  discount        Float     @default(0)
  interest        Float     @default(0)
  fine            Float     @default(0)
  netAmount       Float
  portador        String?
  chequeNumber    String?
  tipoDocto       String?
  filial          String?
  operacao        String?
  observation     String?
  status          String    @default("PENDING")    // PENDING / PAID
  paidDate        DateTime?
  importedAt      DateTime  @default(now())

  @@index([dueDate])
  @@index([supplierDoc])
  @@index([status])
}

// DRE Gerencial (regime de caixa). Cada linha = um evento de caixa classificado,
// agregável por unidade, linha da DRE, subconta e mês. Importado dos relatórios
// de "títulos recebidos" (receita) e "pagamentos efetuados" (despesa).
model DreEntry {
  id        Int      @id @default(autoincrement())
  unit      String                       // unidade canônica (VS - TRÊS RIOS, MM - RIO BONITO, …)
  kind      String                       // RECEITA | DEDUCAO | JUROS | DESPESA
  line      String                       // chave da linha da DRE (CMV, ADM, PESSOAL, FIN, …)
  sub       String                       // subconta (detalhamento)
  supplier  String?                      // razão social (para drill-down)
  supplierCode String?
  year      Int
  month     Int
  amount    Float
  importedAt DateTime @default(now())

  @@index([unit])
  @@index([kind])
  @@index([line])
  @@index([year, month])
}

// CashFlow Analítico da contabilidade (razão de caixa). Visão à PARTE da DRE —
// não entra em nenhum cálculo do DreEntry. Agregado por (filial, tipo, classificação
// contábil 6 níveis, mês). tipo: E = entrada, S = saída. amount assinado (E +, S −).
model CashflowEntry {
  id     Int    @id @default(autoincrement())
  filial String
  tipo   String  // E | S
  c1     String
  c2     String?
  c3     String?
  c4     String?
  c5     String?
  c6     String?
  year   Int
  month  Int
  amount Float   // assinado: E positivo, S negativo (VALOR original)
  n      Int     // qtde de lançamentos agregados
  importedAt DateTime @default(now())

  @@index([tipo])
  @@index([filial])
  @@index([year, month])
}

// ── Controle de Compras (modelo SamFarma adaptado) ──
// Comprador com limite mensal de compras.
model Comprador {
  id     Int     @id @default(autoincrement())
  nome   String  @unique
  limite Float   @default(0)
  setor  String?
  ativo  Boolean @default(true)
}

// Pedido de compra. Parcelamento por DATAS EXPLÍCITAS (`datas` = array ISO de
// vencimentos, valor rateado igualmente). Campos primeiraDias/intervaloDias
// permanecem como fallback de pedidos antigos.
model PurchaseOrder {
  id            Int      @id @default(autoincrement())
  comprador     String
  fornecedor    String?
  tipo          String?  // legado
  categoria     String?  // legado
  dataPedido    DateTime
  valor         Float
  parcelas      Int      @default(1)
  datas         Json?    // ["2026-08-30", "2026-09-30", ...] — datas de pagamento
  primeiraDias  Int      @default(30)
  intervaloDias Int      @default(30)
  status        String   @default("Pendente")
  observacao    String?
  createdAt     DateTime @default(now())

  @@index([comprador])
  @@index([dataPedido])
}

// Pré-cadastro de fornecedores para o lançamento de pedidos.
model Fornecedor {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  ativo Boolean @default(true)
}

// Lista editável de categorias de compra.
model PurchaseCategoria {
  id   Int    @id @default(autoincrement())
  nome String @unique
}

// Parâmetros do controle de compras (meta CMV, etc.).
model PurchaseSetting {
  key   String @id
  value Float
}

// Boletos a pagar do ERP (RELATORIO DE PAGAMENTOS A EFETUAR) — o "comprometido
// real" que consome o limite de compras mês a mês. Wipe-and-replace no import.
model PurchaseCommit {
  id         Int      @id @default(autoincrement())
  fornecedor String
  titulo     String?
  parcela    String?
  dueDate    DateTime
  valor      Float    // VLR LÍQUIDO
  operacao   String?  // COMPRA DE MERCADORIA | COMPRA IMOBILIZADO | COMPRA ENTREGA FUTURA
  tipoDocto  String?
  filial     String?
  importedAt DateTime @default(now())

  @@index([dueDate])
}

// Demanda por cliente — agregado (cliente × produto × mês) do relatório COMERCIAL.
// Alimenta a análise "o que cada cliente compra / deixou de comprar".
model DemandEntry {
  id           Int     @id @default(autoincrement())
  vendedor     String?
  clienteCode  String
  cliente      String
  produtoCode  String?
  produto      String
  year         Int
  month        Int
  qtd          Float
  valor        Float

  @@index([clienteCode])
  @@index([year, month])
}

// Até que dia cada mês da Demanda veio (menor e maior DATA do relatório COMERCIAL nesse
// mês). Mês incompleto conta como parcial em lib/bcg (mesesFechadosVendas): um setembro
// que veio só até o dia 21 não vira "fechado" quando outubro entra. Mês sem registro
// (histórico importado antes de 26/10/2026) segue a regra antiga: completo, menos o
// último mês presente na base.
model DemandaCobertura {
  year      Int
  month     Int
  deDia     String   // YYYY-MM-DD
  ateDia    String   // YYYY-MM-DD
  updatedAt DateTime @updatedAt

  @@id([year, month])
}

// Acesso ao Arken. Duas contas de equipe (compartilhadas, conforme pedido do
// cliente na reunião de 28/08): gerencial vê tudo, comercial só a Demanda.
model User {
  id           Int       @id @default(autoincrement())
  login        String    @unique
  name         String
  passwordHash String
  role         String    @default("comercial") // gerencial | comercial
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Ajuste MANUAL de conciliação da DRE.
// Vive fora de DreEntry de propósito: o import substitui os meses do arquivo e
// apagaria o ajuste junto. A /api/dre soma estes lançamentos aos importados na
// leitura, então o ajuste sobrevive a qualquer reimportação até ser removido.
model DreAjuste {
  id        Int      @id @default(autoincrement())
  unit      String
  kind      String                       // RECEITA | DEDUCAO | JUROS | EXP
  line      String                       // RECEITA, CMV, ADM, …
  sub       String                       // rótulo visível na DRE
  supplier  String?                      // fornecedor do drill-down, quando o ajuste corrige um lançamento dele
  year      Int
  month     Int
  amount    Float
  motivo    String?                      // por que o ajuste existe
  createdAt DateTime @default(now())

  @@index([year, month])
}

// Orçamento (DRE › Orçamento) editado na tela: parâmetros do modelo, premissas
// por linha e os ajustes MÊS A MÊS (13º em nov/dez, contratação, investimento
// pontual…). Fica gravado para o cliente voltar ao mesmo orçamento e para os
// usuários verem a mesma versão. Uma linha por cenário — hoje só 'padrao'.
model OrcamentoCenario {
  id        String   @id
  dados     Json                         // CenarioOrcamento (lib/orcamento.ts)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Matriz de Fornecedores (Controle de Compras): avaliação de RISCO DE
// ABASTECIMENTO feita pelo comprador, uma linha por fornecedor (chave = nome
// agrupado por lib/matriz-fornecedores). A importância vem do gasto pago na DRE.
// Perguntas v2 (16/10/2026): substituto, canal, condições, falhas. A resposta da v1
// a "alternativas" fica guardada só como referência — não entra mais na nota.
model FornecedorRisco {
  chave        String   @id
  nome         String
  tipo         String?                   // LABORATORIO | DISTRIBUIDOR | OUTROS · null = vale o sugerido pelo nome (até 16/10/2026: FABRICANTE | DISTRIBUIDOR | OUTRO)
  substituto   Int?                      // v2 · 0 | 33 | 67 | 100 — quanto o cliente aceita trocar por outra marca
  canal        Int?                      // v2 · 0 | 50 | 100 — outro caminho de compra para os mesmos itens
  condicoes    Int?                      // 0 | 50 | 100
  falhas       Int?                      // 0 | 50 | 100
  alternativas Int?                      // v1 (até 16/10/2026) · 0 | 33 | 67 | 100 — só referência
  updatedAt    DateTime @updatedAt
  updatedBy    String?
}

// ── Faturas de cartão (Fluxo de Caixa › Cartões, desde 11/2026) ──────────────
// O financeiro sobe a fatura (PDF), classifica cada item no plano de contas e a
// DRE troca o pagamento da fatura no caixa pelos itens classificados. Regra que
// não pode quebrar (Sávio, 11/11/2026): NUNCA contar duas vezes. Cada item
// classificado só entra na DRE tirando o MESMO valor de uma linha do caixa
// realizado que pagou a fatura (ver lib/cartao-conciliacao).

// Linhas de SAÍDA do CashFlow Analítico realizado, guardadas pelo import da DRE
// (os meses do arquivo, substituídos junto com a DreEntry). É onde se acha o
// pagamento de cada fatura. line/sub/supplier = o balde da DreEntry em que a
// linha caiu, para a troca acontecer no mesmo lugar.
model CaixaLancamento {
  id        Int      @id @default(autoincrement())
  chave     String   @unique              // data|filial|documento|histórico|valor|caminho#ocorrência — estável entre reimports
  data      DateTime
  filial    String
  unit      String
  kind      String
  line      String
  sub       String
  supplier  String?                        // HISTORICO do CashFlow (= supplier da DreEntry)
  documento String?
  caminho   String                         // CLASSIF_CONTABIL(1..6) unidos por " › "
  valor     Float                          // magnitude
  year      Int
  month     Int
  importedAt DateTime @default(now())

  @@index([year, month])
  @@index([data])
}

model Cartao {
  id      Int     @id @default(autoincrement())
  banco   String                           // ITAU | SAFRA | …
  final   String                           // 4 últimos dígitos
  nome    String?                          // ex.: "ITAU EMPRESAS VISA"
  titular String?
  filial  String?                          // filial do CashFlow em que a fatura é paga (null = descobrir pelo caixa)
  ativo   Boolean @default(true)
  faturas CartaoFatura[]

  @@unique([banco, final])
}

model CartaoFatura {
  id           Int      @id @default(autoincrement())
  cartaoId     Int
  cartao       Cartao   @relation(fields: [cartaoId], references: [id])
  vencimento   DateTime
  total        Float                       // total a pagar da fatura
  saldoAnterior Float   @default(0)        // sobra da fatura anterior que entra neste total (normalmente 0)
  arquivo      String
  hash         String   @unique            // SHA-256 do PDF: a mesma fatura não entra duas vezes
  leitura      String                      // TEXTO | OCR | MANUAL
  createdAt    DateTime @default(now())
  createdBy    String?
  itens        CartaoItem[]
  vinculos     CartaoVinculo[]
}

model CartaoItem {
  id         Int      @id @default(autoincrement())
  faturaId   Int
  fatura     CartaoFatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  ordem      Int
  dataCompra DateTime?
  descricao  String
  parcela    String?                       // "06/12"
  portador   String?                       // titular do cartão adicional, quando a fatura separa
  valor      Float                         // + compra/tarifa · − estorno/crédito
  caminho    String?                       // conta do plano (" › "); null = a classificar
  sugestao   String?                       // conta sugerida pela memória (CartaoRegra)
  classificadoEm DateTime?
  classificadoPor String?

  @@index([faturaId])
}

// Vínculo manual entre a fatura e as linhas do caixa que a pagaram, quando o
// Arken não acha sozinho. itemId nulo = linha que paga o total (ou parte dele).
model CartaoVinculo {
  id       Int     @id @default(autoincrement())
  faturaId Int
  fatura   CartaoFatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  chave    String                          // CaixaLancamento.chave
  itemId   Int?
  createdAt DateTime @default(now())

  @@unique([faturaId, chave])
}

// Memória da classificação: estabelecimento (sem parcela) → conta usada da última vez
model CartaoRegra {
  id        Int      @id @default(autoincrement())
  padrao    String   @unique
  caminho   String
  usos      Int      @default(1)
  updatedAt DateTime @updatedAt
}
