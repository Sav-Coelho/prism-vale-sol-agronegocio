// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Unit {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  active  Boolean  @default(true)
  clients Client[]
  sales   Sale[]
}

model Client {
  id        Int      @id @default(autoincrement())
  code      String?  @unique  // Código do ERP — chave estável de deduplicação
  name      String
  email     String?
  phone     String?
  cpf       String?
  unitId    Int?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Sale {
  id            Int       @id @default(autoincrement())
  clientId      Int
  client        Client    @relation(fields: [clientId], references: [id])
  externalId    String?   // Chave estável do ERP: TITULO::PARCELA (deduplica entre imports)
  description   String
  amount        Float
  date          DateTime
  dueDate       DateTime?
  paidDate      DateTime?
  paymentStatus String    @default("PENDING") // PENDING / PAID / OVERDUE / DEFAULTED
  unitId        Int?
  unit          Unit?     @relation(fields: [unitId], references: [id])
  month         Int
  year          Int
  createdAt     DateTime  @default(now())

  @@unique([clientId, externalId])
  @@index([externalId])
  @@index([paymentStatus])
}

// Títulos a receber importados do ERP do cliente
model Receivable {
  id              Int       @id @default(autoincrement())
  fitid           String    @unique
  dueDate         DateTime
  issueDate       DateTime?
  customerCode    String?
  customerName    String
  customerDoc     String?
  titulo          String
  parcela         String?
  portador        String?
  tipoCobranca    String?
  sellerCode      String?
  sellerName      String?
  farmName        String?
  phone           String?
  amount          Float
  discount        Float     @default(0)
  interest        Float     @default(0)
  fine            Float     @default(0)
  netAmount       Float
  filial          String?
  observation     String?
  status          String    @default("PENDING")    // PENDING / RECEIVED
  receivedDate    DateTime?
  importedAt      DateTime  @default(now())

  @@index([dueDate])
  @@index([customerDoc])
  @@index([status])
}

// Preço de venda (tabela mestre, sem filial) — do XLSX PREÇO DE VENDA
model ProductPrice {
  code        String   @id
  description String
  retailPrice Float
  updatedAt   DateTime @default(now()) @updatedAt
}

// Estoque consolidado (sem filial por ora) — do XLSX ABC DE ESTOQUE (sheet CONSOLIDADO)
model StockItem {
  code        String   @id
  description String
  qty         Float
  unitCost    Float
  totalValue  Float
  updatedAt   DateTime @default(now()) @updatedAt
}

// Curva ABC de vendas consolidada — do XLSX RELATORIO ABC DE VENDAS (sheet CONSOLIDADO)
model SalesAbcItem {
  code        String   @id
  description String
  qtySold     Float
  totalValue  Float
  avgUnit     Float
  abcClass    String   // A / B / C
  updatedAt   DateTime @default(now()) @updatedAt
}

// Pagamentos a efetuar importados do ERP do cliente
model Payable {
  id              Int       @id @default(autoincrement())
  fitid           String    @unique
  dueDate         DateTime
  entryDate       DateTime?
  supplierCode    String?
  supplierName    String
  supplierDoc     String?
  titulo          String
  parcela         String?
  amount          Float
  discount        Float     @default(0)
  interest        Float     @default(0)
  fine            Float     @default(0)
  netAmount       Float
  portador        String?
  chequeNumber    String?
  tipoDocto       String?
  filial          String?
  operacao        String?
  observation     String?
  status          String    @default("PENDING")    // PENDING / PAID
  paidDate        DateTime?
  importedAt      DateTime  @default(now())

  @@index([dueDate])
  @@index([supplierDoc])
  @@index([status])
}

// DRE Gerencial (regime de caixa). Cada linha = um evento de caixa classificado,
// agregável por unidade, linha da DRE, subconta e mês. Importado dos relatórios
// de "títulos recebidos" (receita) e "pagamentos efetuados" (despesa).
model DreEntry {
  id        Int      @id @default(autoincrement())
  unit      String                       // unidade canônica (VS - TRÊS RIOS, MM - RIO BONITO, …)
  kind      String                       // RECEITA | DEDUCAO | JUROS | DESPESA
  line      String                       // chave da linha da DRE (CMV, ADM, PESSOAL, FIN, …)
  sub       String                       // subconta (detalhamento)
  supplier  String?                      // razão social (para drill-down)
  supplierCode String?
  year      Int
  month     Int
  amount    Float
  importedAt DateTime @default(now())

  @@index([unit])
  @@index([kind])
  @@index([line])
  @@index([year, month])
}

// CashFlow Analítico da contabilidade (razão de caixa). Visão à PARTE da DRE —
// não entra em nenhum cálculo do DreEntry. Agregado por (filial, tipo, classificação
// contábil 6 níveis, mês). tipo: E = entrada, S = saída. amount assinado (E +, S −).
model CashflowEntry {
  id     Int    @id @default(autoincrement())
  filial String
  tipo   String  // E | S
  c1     String
  c2     String?
  c3     String?
  c4     String?
  c5     String?
  c6     String?
  year   Int
  month  Int
  amount Float   // assinado: E positivo, S negativo (VALOR original)
  n      Int     // qtde de lançamentos agregados
  importedAt DateTime @default(now())

  @@index([tipo])
  @@index([filial])
  @@index([year, month])
}

// ── Controle de Compras (modelo SamFarma adaptado) ──
// Comprador com limite mensal de compras.
model Comprador {
  id     Int     @id @default(autoincrement())
  nome   String  @unique
  limite Float   @default(0)
  setor  String?
  ativo  Boolean @default(true)
}

// Pedido de compra. Parcelamento por DATAS EXPLÍCITAS (`datas` = array ISO de
// vencimentos, valor rateado igualmente). Campos primeiraDias/intervaloDias
// permanecem como fallback de pedidos antigos.
model PurchaseOrder {
  id            Int      @id @default(autoincrement())
  comprador     String
  fornecedor    String?
  tipo          String?  // legado
  categoria     String?  // legado
  dataPedido    DateTime
  valor         Float
  parcelas      Int      @default(1)
  datas         Json?    // ["2026-08-30", "2026-09-30", ...] — datas de pagamento
  primeiraDias  Int      @default(30)
  intervaloDias Int      @default(30)
  status        String   @default("Pendente")
  observacao    String?
  createdAt     DateTime @default(now())

  @@index([comprador])
  @@index([dataPedido])
}

// Pré-cadastro de fornecedores para o lançamento de pedidos.
model Fornecedor {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  ativo Boolean @default(true)
}

// Lista editável de categorias de compra.
model PurchaseCategoria {
  id   Int    @id @default(autoincrement())
  nome String @unique
}

// Parâmetros do controle de compras (meta CMV, etc.).
model PurchaseSetting {
  key   String @id
  value Float
}

// Boletos a pagar do ERP (RELATORIO DE PAGAMENTOS A EFETUAR) — o "comprometido
// real" que consome o limite de compras mês a mês. Wipe-and-replace no import.
model PurchaseCommit {
  id         Int      @id @default(autoincrement())
  fornecedor String
  titulo     String?
  parcela    String?
  dueDate    DateTime
  valor      Float    // VLR LÍQUIDO
  operacao   String?  // COMPRA DE MERCADORIA | COMPRA IMOBILIZADO | COMPRA ENTREGA FUTURA
  tipoDocto  String?
  filial     String?
  importedAt DateTime @default(now())

  @@index([dueDate])
}

// Demanda por cliente — agregado (cliente × produto × mês) do relatório COMERCIAL.
// Alimenta a análise "o que cada cliente compra / deixou de comprar".
model DemandEntry {
  id           Int     @id @default(autoincrement())
  vendedor     String?
  clienteCode  String
  cliente      String
  produtoCode  String?
  produto      String
  year         Int
  month        Int
  qtd          Float
  valor        Float

  @@index([clienteCode])
  @@index([year, month])
}
